{
  "name": "nct-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "Shared web copy of the NCT Neocore device inventory, stored as one private Vercel Blob document and protected by a shared password. Syncs with each computer's local SQLite (pairing_station) alongside the Git inventory.",
  "scripts": {
    "dev": "next dev",
    "dev:local": "cross-env INVENTORY_STORE=memory next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
