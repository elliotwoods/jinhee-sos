{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NCT Console",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "program": "${workspaceFolder}/console/app.py",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe"
      }
    },
    {
      "name": "PoolZone Calibration & Diagnostics",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "program": "${workspaceFolder}/zones/calibration/app.py",
      "args": [
        "--port",
        "/dev/cu.usbmodem101"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe",
        "args": []
      }
    },
    {
      "name": "Poolzone Light Test",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "program": "${workspaceFolder}/poolzone_test/app.py",
      "args": [
        "--port",
        "/dev/cu.usbmodem101",
        "--central",
        "/dev/cu.usbmodem2101"
      ],
      "cwd": "${workspaceFolder}/poolzone_test",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe",
        "args": []
      }
    },
    {
      "name": "Pairing Station",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "program": "${workspaceFolder}/pairing_station/app.py",
      "args": [
        "--connect"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe"
      }
    },
    {
      "name": "USB Flash Station",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "program": "${workspaceFolder}/flashing_station/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe"
      }
    },
    {
      "name": "Zone Flasher",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "program": "${workspaceFolder}/zones/flasher/app.py",
      "cwd": "${workspaceFolder}/zones/flasher",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe"
      }
    },
    {
      "name": "Zone Database Manager",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "program": "${workspaceFolder}/zones/dbmanager/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe"
      }
    },
    {
      "name": "Mainshow Controller",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "program": "${workspaceFolder}/zones/mainshow/app.py",
      "args": [
        "--connect"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe"
      }
    },
    {
      "name": "Install prerequisites (both apps)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "module": "pip",
      "args": [
        "install",
        "-r",
        "${workspaceFolder}/pairing_station/requirements.txt",
        "-r",
        "${workspaceFolder}/flashing_station/requirements.txt"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Create shared Python environment",
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe"
      }
    },
    {
      "name": "Build all firmwares",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/pairing_station/.venv/bin/python",
      "program": "${workspaceFolder}/scripts/build_all_firmware.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "windows": {
        "python": "${workspaceFolder}/pairing_station/.venv/Scripts/python.exe"
      }
    }
  ]
}
